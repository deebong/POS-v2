  var existing=returnsRead_('ReturnItems'),bySaleItem={};existing.forEach(function(x){if(String(x.invoiceNo).toLowerCase()===invoiceNo.toLowerCase())bySaleItem[x.originalSaleItemId]=(bySaleItem[x.originalSaleItemId]||0)+returnsR3_(x.qty);});
