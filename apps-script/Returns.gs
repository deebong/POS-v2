  input.forEach(function(x){var original=byId[Number(x.originalSaleItemId)];if(!original)throw new Error('Original sale item not found');var qty=returnsR3_(x.qty),remaining=returnsR3_(Number(original.qty)-Number(bySaleItem[original.id]||0));if(!(qty>0)||qty>remaining)throw new Error(original.name+': return quantity exceeds the remaining returnable quantity ('+remaining+')');var tax=returnsNum_(original.taxRate),unitPrice=returnsNum_(original.price);returnedValue+=qty*unitPrice*(1+tax/100);var replacement=null,replacementQty=returnsR3_(x.replacementQty);if(type==='exchange'){replacement=resolveProduct_(readTable_('Products'),x.replacementProductId,x.replacementSku);if(!replacement)throw new Error('Replacement product not found');if(!(replacementQty>0))throw new Error('Enter a replacement quantity for '+replacement.name);if(returnsNum_(replacement.stock)<replacementQty)throw new Error('Not enough stock for '+replacement.name+' (available: '+replacement.stock+' '+replacement.unit+')');replacementValue+=replacementQty*returnsNum_(replacement.price)*(1+returnsNum_(replacement.taxRate)/100);}prepared.push({original:original,qty:qty,replacement:replacement,replacementQty:replacementQty,unitPrice:unitPrice,taxRate:tax});});
