  ReturnItems: [['id','n'],['returnId','n'],['invoiceNo','s'],['originalSaleItemId','n'],['productId','n'],['sku','s'],['name','s'],['unit','s'],['qty','n'],['unitPrice','n'],['taxRate','n'],['replacementProductId','n'],['replacementSku','s'],['replacementName','s'],['replacementQty','n'],['replacementPrice','n'],['replacementTaxRate','n'],['reason','s']],
