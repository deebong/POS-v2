  prepared.forEach(function(x){var p=resolveProduct_(products,x.original.productId,x.original.sku);if(!p)throw new Error('Returned product '+x.original.name+' no longer exists');p.stock=returnsR3_(p.stock+x.qty);p.updatedAt=iso;moves.push(movement_(++nextMove,p,x.qty,'return',returnNo,iso));rows.push({id:++nextItem,returnId:returnId,invoiceNo:invoiceNo,originalSaleItemId:x.original.id,productId:p.id,sku:p.sku,name:p.name,unit:p.unit,qty:x.qty,unitPrice:x.unitPrice,taxRate:x.taxRate,replacementProductId:x.replacement?x.replacement.id:0,replacementSku:x.replacement?x.replacement.sku:'',replacementName:x.replacement?x.replacement.name:'',replacementQty:x.replacementQty,replacementPrice:x.replacement?x.replacement.price:0,replacementTaxRate:x.replacement?x.replacement.taxRate:0,reason:returnsStr_(req.reason,120)});writeRow_('Products',p._row,p);if(x.replacement){var rp=resolveProduct_(products,x.replacement.id,x.replacement.sku);rp.stock=returnsR3_(rp.stock-x.replacementQty);rp.updatedAt=iso;writeRow_('Products',rp._row,rp);moves.push(movement_(++nextMove,rp,-x.replacementQty,'exchange',returnNo,iso));}});
  returnsAppend_('Returns',[rec]);returnsAppend_('ReturnItems',rows);appendRows_('StockMovements',moves);SpreadsheetApp.flush();return{returnRecord:rec,returnItems:rows,settlementText:difference>0?'Collect '+difference:difference<0?'Refund '+Math.abs(difference):'No balance due'};
}
function returnsSync_(req){var ops=Array.isArray(req.ops)?req.ops.slice(0,50):[],log=returnsRead_('ReturnsSyncLog'),seen={};log.forEach(function(x){seen[x.opId]=x;});var results=[];ops.forEach(function(op){var id=returnsStr_(op&&op.opId,64);if(!id){results.push({opId:'',ok:false,error:'Missing opId'});return;}if(seen[id]){results.push({opId:id,ok:seen[id].ok,duplicate:true,error:seen[id].message||undefined});return;}var res;try{res=returnsCreate_(op.payload||{})||{};res.ok=true;}catch(e){res={ok:false,error:String(e&&e.message||e)};}res.opId=id;returnsAppend_('ReturnsSyncLog',[{opId:id,appliedAt:new Date().toISOString(),ok:res.ok,message:res.error||''}]);seen[id]={ok:res.ok,message:res.error||''};results.push(res);});SpreadsheetApp.flush();return{results:results,version:RETURNS_VERSION};}
